# ---------------------------------------------------------------------------
# EduVerse backend configuration.
#
# Copy to `.env` and fill in. Nothing here has a working default: a missing key
# makes its feature report itself unavailable, it never makes the server
# improvise an answer.
#
# This file must never contain real values. Only `.env` does, and `.env` is
# git-ignored.
# ---------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------
# Project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=
# The publishable/anon key. Safe in a browser; also sent as the `apikey` header.
SUPABASE_ANON_KEY=
# The service-role key. NEVER put this in the frontend or in VITE_* variables:
# it bypasses row-level security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (tutor, quiz generation, diagnostic, code mentor) --------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- xAI Grok (alternative to Gemini for tutor, quiz, diagnostic, mentor) ---
# https://console.x.ai/ — a standard API key is enough.
# When both GEMINI_API_KEY and GROK_API_KEY are set, Gemini is used by default.
# When only one is set, that one is used. Both missing means all AI features
# report themselves unavailable.
GROK_API_KEY=
GROK_MODEL=grok-3-mini-fast

# --- Hugging Face (embeddings for retrieval) --------------------------------
# https://huggingface.co/settings/tokens — a read token is enough.
HUGGINGFACE_API_KEY=
# Changing the model means changing the vector(384) column type AND re-embedding
# every existing chunk. Do not change it casually.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- HTTP -------------------------------------------------------------------
# Comma-separated origins allowed to call this API. Add your deployed frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
REQUEST_TIMEOUT_SECONDS=60

# --- Code execution ---------------------------------------------------------
# The grader runs student submissions in a subprocess. It is NOT a security
# sandbox — see backend/app/services/sandbox.py. Run this server in a container
# with no credentials and no outbound network, or set the flag below to false.
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_TIMEOUT_SECONDS=6
CODE_EXECUTION_MEMORY_MB=256
NODE_BINARY=node
# Leave blank to use the interpreter running this server.
PYTHON_BINARY=
