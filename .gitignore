# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets. backend/.env holds the Supabase service-role key and the Gemini and
# Hugging Face API keys; the root .env holds the public VITE_* values. Neither
# may ever be committed.
.env
.env.*
!.env.example
!backend/.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Supabase local files
supabase/.temp/

# TypeScript incremental build state, written by `npm run typecheck`.
*.tsbuildinfo

# Claude local settings. Note the *.local rule above does not cover this:
# the filename is settings.local.json, so the pattern has to be spelled out.
.claude/settings.local.json
