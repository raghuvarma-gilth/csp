# ---------------------------------------------------------------------------
# EduVerse frontend configuration.
#
# Copy to `.env` and fill in. Everything in this file is compiled into the
# JavaScript bundle and is readable by anyone who opens the site, so it may
# hold ONLY values that are safe in public.
#
# Never add here: GEMINI_API_KEY, HUGGINGFACE_API_KEY,
# SUPABASE_SERVICE_ROLE_KEY. Those belong in `backend/.env`, which the browser
# never sees.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
VITE_SUPABASE_URL=
# The publishable/anon key. Public by design: it grants nothing on its own,
# because row-level security decides what each signed-in user may read.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Site address ----------------------------------------------------------
# Where this build will be served from, without a trailing slash. Used for
# canonical/og:url tags and by scripts/generate-seo.ts for sitemap.xml and
# robots.txt. Leave blank only for local work: if it is unset at build time the
# build warns and falls back to a reserved example.com address, so a deployment
# that forgets it publishes an obviously wrong sitemap rather than a plausible
# one pointing at somebody else's site.
VITE_SITE_URL=

# --- API server -------------------------------------------------------------
# The FastAPI backend in `backend/`. This is the primary deployment path.
#   local:      http://localhost:8000/api
#   deployed:   https://api.your-domain.example/api
#
# Leave it blank to use the Supabase Edge Functions in `supabase/functions/`
# instead; they implement the same contract. Screens that need the GET routes
# (faculty corpus management, focus history) will say so rather than break.
VITE_API_URL=http://localhost:8000/api
